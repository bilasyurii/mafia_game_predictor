{
  "name": "mafia_game_predictor",
  "version": "1.0.0",
  "description": "Probabilistic predictor for Mafia board game",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "npm run build:web && node web/scripts/serve.js",
    "test": "node --require ts-node/register --test \"src/**/*.test.ts\"",
    "typecheck:web": "tsc --noEmit -p web/tsconfig.json",
    "build:web": "esbuild web/src/app.ts --bundle --outfile=web/dist/bundle.js --format=iife",
    "test:web": "TS_NODE_PROJECT=web/tsconfig.json node --require ts-node/register --test \"web/src/**/*.test.ts\"",
    "playtest": "npm run build:web && node web/scripts/playtest.js",
    "deploy:web": "npm run build:web && node web/scripts/deploy.js"
  },
  "author": "Yurii Bilas",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
