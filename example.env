# Copy this file to .env and fill in your real FTP details. .env is
# git-ignored, so those values never get committed - see web/scripts/deploy.js.

FTP_HOST=ftp://your-host.example.com
FTP_PORT=21
FTP_USER=your-ftp-username
FTP_PASSWORD=your-ftp-password
# Path from the FTP login root to the folder the built site's own files
# (index.html, styles.css, dist/) get uploaded into. Only those exact
# files are ever uploaded - nothing else already in this folder (such as
# a sibling "v1" folder) is touched or deleted.
FTP_REMOTE_DIR=htdocs/your-folder
